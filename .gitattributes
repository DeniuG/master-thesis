# Автоматически определять текстовые файлы и нормализовать концы строк
* text=auto

# Markdown, txt, скрипты — всегда LF в репозитории, LF в рабочей копии
*.md   text eol=lf
*.txt  text eol=lf
*.sh   text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Windows-скрипты — CRLF при выгрузке
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Бинарные файлы — Git не должен их трогать
*.docx binary
*.doc  binary
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.zip  binary
*.xlsx binary
*.pptx binary